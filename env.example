# U-HRES. Copy to .env (do not commit .env)
# The clinician portal (npm run dev) talks to /api/hie on the same origin.
# The FastAPI exchange is optional for local/GitHub runs.

# --- FastAPI exchange (backend/) ---
UHRES_JWT_SECRET=change-me-before-any-shared-deploy
UHRES_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
UHRES_NODE_NAME=FUTO Health Exchange
UHRES_ENV=development

